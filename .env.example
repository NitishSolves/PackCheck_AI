# PackCheck AI — environment template
# Copy to .env and fill in local values. Never commit secrets.

NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# PostgreSQL
DATABASE_URL=postgres://packcheck:packcheck@localhost:5432/packcheck

# Independently replaceable AI/CV/OCR service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=3002
AI_SERVICE_URL=http://localhost:3002
# Provider mode: 'gemini' | 'demo' | 'unconfigured'
AI_PROVIDER=gemini
# Optional Google Gemini Vision API Keys (auto-rotates Key 1 and Key 2)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_SECONDARY=your_secondary_gemini_key_here

# Private local object storage for images, crops, and reports
OBJECT_STORAGE_DIR=./data/uploads

# Optional overrides for development seed users (never production secrets)
SEED_ADMIN_PASSWORD=PackCheckAdmin!dev
SEED_REVIEWER_PASSWORD=PackCheckReviewer!dev
SEED_INSPECTOR_PASSWORD=PackCheckInspector!dev

# Frontend (Vite)
VITE_API_BASE_URL=/api
